{
  "_comment": "trade-gateway 的 MCP 配置片段 —— 实盘交易网关，**默认 enabled:false**。只有显式运行 scripts/install.ps1 -EnableTrading -QmtPath \"<QMT安装目录>\" 才会被写成 true，且优先审计使用 dry_run。xtquant 随 QMT/MiniQMT 客户端分发、不在 PyPI（同名包多为非官方上传），所以脚本不 pip install，而是把 <QmtPath>\\bin.x64\\Lib\\site-packages 通过 PYTHONPATH 注入 —— 请把 PYTHONPATH 的值换成你本机 QMT 的真实路径。QUANT_QMT_PATH 填 QMT 的 userdata_mini 目录（即 XtQuantTrader 的第一个参数），不是安装根目录。QUANT_TRADE_DRY_RUN=1（默认）时下单只写本地 orders 表、不报券商；要真报单必须显式改成 0 且用户已人工贴回确认码。【Windows 中文系统必看】env 必须含 PYTHONUTF8=1 与 PYTHONIOENCODING=utf-8，否则含中文的结果（如复核结论「通过」）会因 GBK/UTF-8 不匹配导致 60 秒超时。",
  "middlewares": [],
  "mcpServers": {
    "trade-gateway": {
      "enabled": false,
      "type": "stdio",
      "command": "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\mcp\\quant-data\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\mcp\\quant-agent\\trade-gateway\\server.py"
      ],
      "cwd": "C:\\绝对路径\\deer-flow\\backend",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "C:\\QMT\\bin.x64\\Lib\\site-packages",
        "QUANT_DB_PATH": "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\data\\quant.db",
        "QUANT_TRADE_DRY_RUN": "1",
        "QUANT_QMT_PATH": "C:\\QMT\\userdata_mini",
        "QUANT_QMT_ACCOUNT": "<你的资金账号>",
        "QUANT_QMT_ACCOUNT_TYPE": "stock",
        "QUANT_MAX_ORDER_AMOUNT": "100000",
        "QUANT_MAX_POSITION_PCT": "0.30",
        "QUANT_CANCEL_SELL_ONLY": "1"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 120,
      "tool_call_timeout": 60,
      "description": "实盘交易网关（xtquant/QMT，默认关闭）：交易模式与闸门状态、资金账户、持仓、委托、成交查询，以及准备下单（生成 6 位确认码）、下单、撤单。四道闸：默认关闭 + 风控复核凭证 + 人工确认码 + 下单前重校验。",
      "capability": {
        "id": "trade-gateway"
      },
      "routing": {
        "mode": "prefer",
        "priority": 90,
        "keywords": [
          "下单",
          "买入",
          "卖出",
          "报单",
          "委托",
          "撤单",
          "持仓",
          "可用资金",
          "账户",
          "成交回报",
          "实盘",
          "QMT",
          "miniQMT",
          "确认码",
          "dry_run",
          "交易模式"
        ]
      }
    }
  },
  "skills": {
