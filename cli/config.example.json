{
  "model": "deepseek-v4-pro",
  "base_url": "https://api.deepseek.com/v1",
  "api_key_env": "DEEPSEEK_API_KEY",
  "temperature": 0.2,
  "max_turns": 30,
  "timeout": 600,
  "project_root": "..",
  "mcp_servers": {
    "quant-data": {
      "enabled": true,
      "command": "C:/path/to/quant-data/.venv/Scripts/python.exe",
      "args": ["C:/path/to/quant-agent/mcp-servers/quant-data/server.py"],
      "env": {
        "QUANT_DB_PATH": "C:/path/to/deer-flow/backend/.deer-flow/data/quant.db",
        "QUANT_DATA_TIMEOUT": "25",
        "QUANT_DATA_RETRY": "2"
      }
    },
    "quant-db": {
      "enabled": true,
      "command": "uvx",
      "args": ["--python", "3.12", "--with", "mcp==1.2.1", "--with", "pydantic==2.11.7",
               "mcp-server-sqlite",
               "--db-path", "C:/path/to/deer-flow/backend/.deer-flow/data/quant.db"],
      "env": {
        "UV_DEFAULT_INDEX": "https://pypi.tuna.tsinghua.edu.cn/simple"
      }
    },
    "trade-gateway": {
      "enabled": true,
      "command": "C:/path/to/quant-data/.venv/Scripts/python.exe",
      "args": ["C:/path/to/quant-agent/mcp-servers/trade-gateway/server.py"],
      "env": {
        "QUANT_DB_PATH": "C:/path/to/deer-flow/backend/.deer-flow/data/quant.db",
        "QUANT_TRADE_DRY_RUN": "1",
        "QUANT_MAX_ORDER_AMOUNT": "100000",
        "QUANT_MAX_POSITION_PCT": "0.30",
        "QUANT_CANCEL_SELL_ONLY": "1"
      }
    }
  }
}
