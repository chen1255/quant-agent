{
  "_comment": "quant-data 的 MCP 配置片段。运行 scripts/install.ps1 会自动把它合并进 deer-flow 根目录的 extensions_config.json，并把 command/QUANT_DB_PATH 写成你本机的绝对路径；手工安装时把 mcpServers.quant-data 与 skills 两段合并即可。该 server 是自建 Python stdio server（mcp-servers/quant-data/server.py），依赖 akshare + baostock，install.ps1 会为它建独立 venv（与 machine-db 锁定的 mcp==1.2.1 环境隔离）。【Windows 中文系统必看】env 必须含 PYTHONUTF8=1 与 PYTHONIOENCODING=utf-8，否则子进程按 GBK 写 stdout，含中文的结果（如「贵州茅台」「沪深300ETF」）会被 MCP client 按 UTF-8 解码失败，表现为工具调用 60 秒超时。【超时】akshare 首次 import 与冷启动较慢，故 session_init_timeout=180、tool_call_timeout=120。",
  "middlewares": [],
  "mcpServers": {
    "quant-data": {
      "enabled": true,
      "type": "stdio",
      "command": "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\mcp\\quant-data\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\mcp\\quant-agent\\quant-data\\server.py"
      ],
      "cwd": "C:\\绝对路径\\deer-flow\\backend",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1",
        "QUANT_DB_PATH": "C:\\绝对路径\\deer-flow\\backend\\.deer-flow\\data\\quant.db",
        "QUANT_DATA_TIMEOUT": "25",
        "QUANT_DATA_RETRY": "2"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 180,
      "tool_call_timeout": 120,
      "description": "A股与ETF行情/标的/基本面取数：交易日历、标的台账（含退市标的与板块）、带复权因子的日线、带公告日(pub_date)的基本面、涨跌停与停牌状态、指数成分股。本地缓存落 quant-db。",
      "capability": {
        "id": "quant-data"
      },
      "routing": {
        "mode": "prefer",
        "priority": 75,
        "keywords": [
          "行情",
          "日线",
          "K线",
          "复权",
          "前复权",
          "后复权",
          "收盘价",
          "成交额",
          "换手率",
          "标的",
          "代码",
          "ETF",
          "股票",
          "指数",
          "成分股",
          "沪深300",
          "中证500",
          "创业板",
          "交易日历",
          "基本面",
          "公告日",
          "市盈率",
          "ROE",
          "财报",
          "涨跌停",
          "涨停",
          "跌停",
          "停牌",
          "退市",
          "取数",
          "更新数据"
        ]
      }
    }
  },
  "skills": {
    "data-ops": { "enabled": true },
    "market-research": { "enabled": true },
    "factor-screening": { "enabled": true },
    "strategy-backtest": { "enabled": true },
    "signal-review": { "enabled": true },
    "live-trading": { "enabled": true },
    "risk-limits": { "enabled": true }
  }
}
